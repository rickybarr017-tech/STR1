//FR8 func para piscar luz
void piscaCima() {
    static int contadorCiclos = 0; //static para nao ficar a 0 cada vez que chama outra vez no while 
    static bool estadoLuz = false;
    contadorCiclos++;
    if (contadorCiclos >= 10) { //taskDelay esta a 10 10x10 = 100ms 0.1s (maybe aumentar) meter assim para nao dar overflow com o %10 == 0
        estadoLuz = !estadoLuz;
        AtivarLuzCima(estadoLuz);
        contadorCiclos = 0;
    }
}

void piscaBaixo() {
    static int contadorCiclos = 0; //static para nao ficar a 0 cada vez que chama outra vez no while 
    static bool estadoLuz = false;
    contadorCiclos++;
    if (contadorCiclos >= 10) { //taskDelay esta a 10 10x10 = 100ms 0.1s (maybe aumentar) meter assim para nao dar overflow com o %10 == 0
        estadoLuz = !estadoLuz;
        AtivarLuzBaixo(estadoLuz);
        contadorCiclos = 0;
    }
}

void piscarDuasLuzesFast() {
    static int contadorCiclos = 0; //static para nao ficar a 0 cada vez que chama outra vez no while 
    static bool estadoLuz = false;
    contadorCiclos++;
    if (contadorCiclos >= 5) { //METER MAIS BAIXO QUE OS OUTROS PISCAS!!!!!!! TEM DE SER MAIS RAPIDO
        estadoLuz = !estadoLuz;
        AtivarLuzCima(estadoLuz);
        AtivarLuzBaixo(!estadoLuz);
        contadorCiclos = 0;
    }
}

