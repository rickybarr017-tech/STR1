//FR8 piscarLuz no while e desligar a lluz nos returns
bool putPartInCell(int x, int z)
{
    if (!estaCalibrado()) {
        printf("Kit nao calibrado.\n");
        return true;
    }
   //FR8 meter upper light a flashar

    if (!gotoX(x, 1)) { AtivarLuzCima(false); return false; } //desligar
    if (!gotoZ(z, 1)) { AtivarLuzCima(false); return false; }

    //ir para baixo para a caixa ficar lá
    //moveZUp();
    while (getZPosicaoCell() == -1) {//  até atingir o primeiro sensor
        moveZUp();
        piscaCima();
        if (ParagemEmergencia()) { AtivarLuzCima(false);  return false; }
        vTaskDelay(10);
    }
    stopZ();
    //mal recebemos o 1 false paramos tava a ficar com 3 prints do PARAGEM EMERGENCIA
    if (!gotoY(3,1)) { AtivarLuzCima(false); return false; }    // Entra lá
    if (!gotoZ(z,1)) { AtivarLuzCima(false); return false; }
    if (!gotoY(2,1)) { AtivarLuzCima(false); return false; }     // Sai de lá

    AtivarLuzCima(false);
