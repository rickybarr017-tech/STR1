int getBitValue(uInt8 value, uInt8 bit_n)
// given a byte value, returns the value of its bit n
{
    return(value & (1 << bit_n));
}


void setBitValue(uInt8* variable, int n_bit, int new_value_bit)// given a byte value, set the n bit to value
{
    uInt8 mask_on = (uInt8)(1 << n_bit);
    uInt8 mask_off = ~mask_on;
    if (new_value_bit) *variable |= mask_on;
    else *variable &= mask_off;
}


// X axis related functions

void moveXLeft()
{
    uInt8 p = readDigitalU8(2); // read port 2
    setBitValue(&p, 6, 1); // set bit 6 to high level
    setBitValue(&p, 7, 0); // set bit 7 to low level
    writeDigitalU8(2, p); // update port 2
}

void moveXRight()
{
    uInt8 p = readDigitalU8(2); // read port 2
    setBitValue(&p, 6, 0); // set bit 6 to low level
    setBitValue(&p, 7, 1); // set bit 7 to high level
    writeDigitalU8(2, p); // update port 2
}

void stopX()
{
    uInt8 p = readDigitalU8(2); // read port 2
    setBitValue(&p, 6, 0); // set bit 6 to low level
    setBitValue(&p, 7, 0); // set bit 7 to low level
    writeDigitalU8(2, p); // update port 2
}

int getXPos()
{
    uInt8 p = readDigitalU8(0);
    if (!getBitValue(p, 2))
        return 1;
    if (!getBitValue(p, 1))
        return 2;
    if (!getBitValue(p, 0))
        return 3;
    return(-1);
}

//mudar gotos para bools para caso parem sabermos 
bool gotoX(int x, int piscar = 0) {
    int x_pos = getXPos();

    if (x < 1 || x > 3) return false;
    if (x == x_pos) return true;

    // se a posição for -1, move para a esquerda até encontrar um sensor
    if (x_pos == -1) {
        //moveXLeft();
        while (getXPos() == -1) {//  até atingir o primeiro sensor
            moveXLeft(); //meter o move dentro dos whiles, porque saimos da paragem, e voltamos a estes whiles 
            if (piscar == 1) piscaCima();
            if (piscar == 2) piscaBaixo();
            if (ParagemEmergencia()) return false;
            vTaskDelay(10);
        }
        stopX();
        x_pos = getXPos(); // atualiza a posição 
    }
    if (x_pos < x) {
        //moveXRight();
        while (getXPos() != x) {
            moveXRight();
            if (piscar == 1) piscaCima();
            if (piscar == 2) piscaBaixo();
            if (ParagemEmergencia()) return false;;
            vTaskDelay(10);
        }
        stopX();
    }
    else if (x_pos > x) {
        //moveXLeft();
        while (getXPos() != x) {
            moveXLeft();
            if (piscar == 1) piscaCima();
            if (piscar == 2) piscaBaixo();
            if (ParagemEmergencia()) return false;
            vTaskDelay(10);
        }
        stopX();
    }
    return true;
}

