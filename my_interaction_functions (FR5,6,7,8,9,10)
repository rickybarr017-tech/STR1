}

bool takePartFromCell(int x, int z)
{
    if (!estaCalibrado()) {
        printf("Kit nao calibrado.\n");
        return true;
    }
    //FR9 
    if (!gotoX(x, 2)) return false;
    if (!gotoZ(z, 2)) return false;
    if(!gotoY(3,1)) return false;      // Entra na célula

    //ir para baixo para a caixa ficar lá
    //moveZUp();
    while (getZPosicaoCell() == -1) {//  até atingir o primeiro sensor
        piscaBaixo();
        moveZUp();
        if (ParagemEmergencia()) return false;
        vTaskDelay(10);
    }
    stopZ();
    if (!gotoY(2,1)) return false;      // Sai da célula
    if(!gotoZ(z,2)) return false;

    AtivarLuzBaixo(false);
    return true;
}

// porto 1, Bit 5 - superior
bool botaoCimaPressionado() {
    uInt8 p1 = readDigitalU8(1);

    return getBitValue(p1, 5) != 0; // Retorna true se o botao estiver premido
}

// porto 1, Bit 6 - inferior
bool botaoBaixoPressionado() {
    uInt8 p1 = readDigitalU8(1);

    return getBitValue(p1, 6) != 0;
}

// luz Superior Porto 2, Bit 0
void AtivarLuzCima(bool state) {

    taskENTER_CRITICAL();

    uInt8 p2 = readDigitalU8(2);
    setBitValue(&p2, 0, state ? 1 : 0);  //se state for true mete-se a 1 para ligar a luz, senao 0
    writeDigitalU8(2, p2);

    taskEXIT_CRITICAL(); //porto 2 e preciso
}

// luz Inferior Porto 2, Bit 1
void AtivarLuzBaixo(bool state) {
    taskENTER_CRITICAL();

    uInt8 p2 = readDigitalU8(2);
    setBitValue(&p2, 1, state ? 1 : 0);
    writeDigitalU8(2, p2);

    taskEXIT_CRITICAL();
}


static bool calibrado = false;

bool estaCalibrado() {
    return calibrado;
}

void calibrarKit() {

    printf("\nA iniciar calibracao \n");

    gotoY(2,0);

    gotoZ(1,0);

    gotoX(1, 0);

    calibrado = true;
    printf("Calibrado com sucesso na posicao (X=1, Y=2, Z=1)\n");
}

//agora temos de chamar esta funcao tipo em todo o lado para ver se os botoes nao estao a ser carregados
//ele nao esta a parar que o butao e pressionado e é logo largado 
bool ParagemEmergencia() { //FR5 6 7
    if (botaoBaixoPressionado() && botaoCimaPressionado()) {
        stopX(); 
        stopY();
        stopZ();
        printf("\nPARAGEM DE EMERGENCIA\n");
        printf("\nPrima o botao superior para retomar\n");
        printf("Primma o butao inferior para efetuar o reset do sistema\n");
        vTaskDelay(200);//precisa para dar tempo para largar os butoes 
        //fica preso sem devolver nada ate decidirmos FR6
        while (1) {
            piscarDuasLuzesFast();
            if (botaoCimaPressionado() && !botaoBaixoPressionado()) {
                printf("A retomar operacao\n");
                vTaskDelay(200);//tempo para largar butoes
                return false;
            }
            //FR7
            else if (!botaoCimaPressionado() && botaoBaixoPressionado()) {
                printf("A efetuar o reset do sistema");
                vTaskDelay(200);
                return true; //parar
            }
            vTaskDelay(10);
        }
    }
    return false;
}

